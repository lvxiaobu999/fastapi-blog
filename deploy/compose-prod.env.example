# 单机 Docker Compose 生产参数示例。
# 复制为 deploy/compose-prod.env 后填写真实密码，再上传到 ECS：
#   /opt/fastapi-blog/config/compose-prod.env
# 真实文件含数据库/Redis 启动密码，只允许 root:docker 读取（chmod 640），不要提交 Git。

# 浏览器入口和 Nginx server_name；必须与证书域名、app.env 的 ALLOWED_HOSTS 一致。
APP_DOMAIN=www.sanwan.xyz

# 发布时由 Git 短 SHA 覆盖，避免线上无法判断实际代码版本。
APP_IMAGE_TAG=production

# 固定 Compose 项目名，避免在错误目录产生另一套容器。
COMPOSE_PROJECT_NAME=fastapi-blog-prod

# FastAPI 运行时文件，由 services.app.env_file 注入 app 容器。
APP_ENV_FILE=/opt/fastapi-blog/config/app.env

# PostgreSQL/Redis 容器只加入 backend 内网，不映射公网端口。
# 用户名和数据库名由本文件统一维护；app.env 不再重复保存连接串。数据目录已有数据后改这些值不会重置账号。
POSTGRES_USER=fastapi_blog
POSTGRES_DB=fastapi_blog_postgresql

# 必填敏感值：使用随机密码，建议只包含字母、数字、点、短横线和下划线。
# Compose 会把它自动注入 PostgreSQL 容器和 app 的 DATABASE_URL。
POSTGRES_PASSWORD=

# 必填敏感值：Compose 会把它自动注入 Redis 容器和 app 的 REDIS_URL。
REDIS_PASSWORD=

# PostgreSQL、Redis、媒体宿主机持久化目录；建议放到独立数据盘并异地备份。
PG_DATA_PATH=/opt/fastapi-blog/data/postgres
REDIS_DATA_PATH=/opt/fastapi-blog/data/redis
MEDIA_HOST_PATH=/opt/fastapi-blog/data/media

# Nginx 只读挂载证书目录，必须包含 fullchain.pem 和 privkey.key。
TLS_HOST_PATH=/opt/fastapi-blog/secrets/tls
