# 生产环境非敏感配置。真实凭据应由部署平台或操作系统环境变量注入。
# ENV=production 会启用 PostgreSQL 类型校验。
# DATABASE_URL 不应写入本文件；postgresql+psycopg:// 可同时支持 SQLAlchemy 异步引擎。
# PROJECT_TITLE 会显示在生产环境的 OpenAPI 文档中。
ENV=production
# DATABASE_URL 必须由生产运行环境提供。
# 格式示例：postgresql+psycopg://<用户名>:<密码>@<主机>:5432/<数据库名>

PROJECT_TITLE = 生产环境项目标题

# REDIS_URL 可能含密码，应由部署平台 Secret 注入；容器内通常使用 redis 服务名。
# 示例（不要提交真实密码）：redis://:<密码>@redis:6379/0
REDIS_KEY_PREFIX=fastapi-blog:production
REDIS_SOCKET_TIMEOUT_SECONDS=2
# 无状态 Access Token 保持较短；Refresh 最长 7 天、连续 24 小时未刷新则失效。
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_IDLE_TIMEOUT_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 生产环境输出单行 JSON 到 stdout，由 Docker/Kubernetes 日志采集器统一收集。
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=false
# 下面配置仅在单机部署并显式启用 LOG_TO_FILE=true 时生效。
LOG_DIRECTORY=logs
LOG_MAX_BYTES=52428800
LOG_FILES_PER_DAY=5
LOG_RETENTION_DAYS=30
