# 开发环境配置。系统环境变量优先级更高，可以临时覆盖这里的值。
# ENV 决定加载哪个 .env.<environment> 文件，拼写必须与 Settings 允许值一致。
# DATABASE_URL 使用 aiosqlite 异步驱动和项目根目录 SQLite 文件，不用于生产。
# PROJECT_TITLE 会显示在 FastAPI OpenAPI 和 Swagger 文档中。
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./fastapi_blog.db

PROJECT_TITLE = 三碗博客开发环境
# Host 白名单只写主机名，不带协议、端口或路径；test/testserver 供本地自动化测试使用。
ALLOWED_HOSTS=["localhost","127.0.0.1","::1","test","testserver"]

# 本机 FastAPI 连接宿主机 Redis；Redis 必须先在 6379 端口启动。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=fastapi-blog:development
REDIS_SOCKET_TIMEOUT_SECONDS=2
# Access JWT 不访问 Redis；Refresh 最长 7 天，连续 24 小时未使用则失效。
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_IDLE_TIMEOUT_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 开发环境使用文本方便直接阅读；DEBUG 会输出更多诊断信息，日常使用 INFO 即可。
LOG_LEVEL=DEBUG
LOG_FORMAT=text
# 本地默认写终端；调试文件轮转时改为 true，生成 logs/YYYY-MM-DD.log。
LOG_TO_FILE=false
LOG_DIRECTORY=logs
# 单文件最大 20 MiB；每天最多 5 个文件，单日上限约 100 MiB。
LOG_MAX_BYTES=20971520
LOG_FILES_PER_DAY=5
# 仅文件模式生效：按 UTC 日期保留最近 14 天。
LOG_RETENTION_DAYS=14
