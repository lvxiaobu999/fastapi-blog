# 开发环境配置。系统环境变量优先级更高，可以临时覆盖这里的值。
# ENV 决定加载哪个 .env.<environment> 文件，拼写必须与 Settings 允许值一致。
# DATABASE_URL 使用 aiosqlite 异步驱动和项目根目录 SQLite 文件，不用于生产。
# PROJECT_TITLE 会显示在 FastAPI OpenAPI 和 Swagger 文档中。
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./fastapi_blog.db

PROJECT_TITLE = 开发环境项目标题

# 开发环境使用文本方便直接阅读；DEBUG 会输出更多诊断信息，日常使用 INFO 即可。
LOG_LEVEL=DEBUG
LOG_FORMAT=text
# 本地默认写终端，调试文件轮转时才临时改为 true。
LOG_TO_FILE=false
LOG_DIRECTORY=logs
# 单文件最大 20 MiB；每个通道每天最多 5 个文件，单通道上限约 100 MiB。
LOG_MAX_BYTES=20971520
LOG_FILES_PER_DAY=5
# 仅文件模式生效：按 UTC 日期保留最近 14 天。
LOG_RETENTION_DAYS=14
